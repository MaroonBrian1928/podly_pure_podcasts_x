# ===================
# --- Basic Setup ---
# ===================

# NOTE: Environment variables set here always take precedence over settings
# configured through the web UI. Fields controlled by env vars will appear
# as read-only in the UI. Remove an env var to allow UI control again.

# Podly will work out of the box with just a valid Groq key
# You can do more advanced setup with alternative hosted models or
# self-hosted OpenAI-compatible services below.
GROQ_API_KEY=gsk_abcdefghjiklmnopqrstuvwxyz

# ======================
# --- Advanced Setup ---
# ======================

# ========================================
# --- LLM (OpenAI-compatible or proxy) ---
# ========================================

# Base URL is IGNORED when LLM_MODEL is provider-prefixed like the examples below:
# groq/openai/gpt-oss-120b  (Groq API)
# anthropic/claude-3.5-sonnet (Anthropic API)
# gemini/gemini-3-flash-preview (Google API)
# gemini/gemini-2.0-flash (Google API)

# Base URL is USED for:
# Unprefixed models like gpt-4o
# Self-hosted OpenAI-compatible endpoints
# LiteLLM proxy servers or local LLMs

LLM_API_KEY=sk-your-openai-or-compatible-key
LLM_MODEL=gpt-4o

# locally hosted endpoint
# OPENAI_BASE_URL=

# Advanced LLM tuning (all optional)
# OPENAI_TIMEOUT=300
# OPENAI_MAX_TOKENS=4096
# LLM_MAX_CONCURRENT_CALLS=3
# LLM_MAX_RETRY_ATTEMPTS=5
# LLM_ENABLE_TOKEN_RATE_LIMITING=false
# LLM_MAX_INPUT_TOKENS_PER_CALL=  # leave blank to disable
# LLM_MAX_INPUT_TOKENS_PER_MINUTE=  # leave blank to disable

# =========================
# --- Whisper selection ---
# =========================

# Choose: remote | groq
WHISPER_TYPE=groq

# Remote Whisper (OpenAI-compatible)
WHISPER_REMOTE_API_KEY=
WHISPER_REMOTE_BASE_URL=https://api.openai.com/v1
WHISPER_REMOTE_MODEL=whisper-1
WHISPER_REMOTE_TIMEOUT_SEC=600
WHISPER_REMOTE_CHUNKSIZE_MB=24
# Optional OpenAI-compatible diarization flags
# Requires a backend that supports these extra transcription parameters.
# speaker embeddings only apply when diarization is enabled.
WHISPER_REMOTE_DIARIZE=false
WHISPER_REMOTE_SPEAKER_EMBEDDINGS=false

# Optional INA audio segmentation
# Enables a separate INA-compatible HTTP service that tags non-speech regions
# such as music, noise, and silence-like gaps for stats/debugging and prompt cues.
# Expected API: POST {INA_BASE_URL}/segment
INA_ENABLED=false
INA_BASE_URL=http://localhost:8001
INA_TIMEOUT_SEC=3600

# Groq Whisper
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_MAX_RETRIES=0

# ===============
# --- General ---
# ===============

SERVER_THREADS=1

# Show extended troubleshooting details in the episode stats modal.
# Includes guid, download_url, audio paths, and resolved path candidates.
PODLY_STATS_DEBUG=false

# =====================
# --- Authentication ---
# =====================

# Set REQUIRE_AUTH=true to enable login for the web UI, feeds, and downloads
# REQUIRE_AUTH=true
# PODLY_ADMIN_USERNAME=podly_admin
# PODLY_ADMIN_PASSWORD=ChangeMe123!
# PODLY_SECRET_KEY=replace-with-a-strong-random-value

# Optional UI feature flags
# Hides Discord SSO/config integration surfaces such as the login button and Config tab.
# PODLY_HIDE_DISCORD_INTEGRATION=false
# Hides the "Report issue" button in the desktop nav and mobile menu.
# PODLY_HIDE_REPORT_ISSUE_BUTTON=false
